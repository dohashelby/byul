{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.byul.invalid/0.1/run-context.schema.json",
  "title": "격리 실험 실행 문맥 (update → runtime)",
  "description": "runtime 계획서 §5.4의 run-context.json. update가 runtime 통제를 켠 채 시험할 때 발급한다. runtime은 run_id를 Gateway·관측 기록의 run_id로 그대로 쓴다. 운영 사건에는 run_id를 만들지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_ref", "side", "evaluation_refs", "environment_ref", "target_ref", "policy_ref", "window"],
  "properties": {
    "schema_version": { "const": "byul-run-context/0.1" },
    "run_id": {
      "description": "serving-guard PLAN ID와 같은 값.",
      "type": "string",
      "pattern": "^PLAN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "plan_ref": { "$ref": "common.schema.json#/$defs/object_ref" },
    "side": { "enum": ["baseline", "candidate", "single"] },
    "evaluation_refs": {
      "description": "이 실행에서 시험하는 점검 ID.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/check_id" },
      "uniqueItems": true
    },
    "environment_ref": { "$ref": "common.schema.json#/$defs/doc_ref" },
    "target_ref": { "$ref": "common.schema.json#/$defs/local_id" },
    "policy_ref": { "$ref": "common.schema.json#/$defs/nullable_policy_ref" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "finished_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" }
      }
    }
  }
}

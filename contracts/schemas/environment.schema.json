{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.byul.invalid/0.1/environment.schema.json",
  "title": "기업 환경 (platform → update, runtime)",
  "description": "통합 플랫폼에서 입력하는 서빙 환경. update는 ENV 객체로, runtime은 runtime-target/1.0 등록으로 변환해 쓴다. 값을 모르면 null로 둔다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "revision", "created_at", "data_origin", "target", "facts"],
  "properties": {
    "schema_version": { "const": "byul-environment/0.1" },
    "environment_id": { "$ref": "common.schema.json#/$defs/local_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "data_origin": { "$ref": "common.schema.json#/$defs/data_origin" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "engine", "model"],
      "properties": {
        "target_ref": {
          "description": "논리 대상 ID. runtime 정책의 target_id와 같은 값이어야 한다.",
          "$ref": "common.schema.json#/$defs/local_id"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "image_digest", "source_commit"],
          "properties": {
            "name": {
              "description": "엔진 식별자(소문자). 정규 값은 vllm·sglang·tensorrt-llm이고 모의 엔진은 mock이다. 화면 표시 이름(vLLM·SGLang 등)은 넣지 않는다. 소비자는 모르는 식별자를 지원하지 않는 엔진으로 다룬다.",
              "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "runtime_kind": {
              "description": "runtime이 연결할 엔진 종류. runtime이 아직 연결하지 않는 값이면 runtime이 거부한다.",
              "enum": ["mock", "vllm", "sglang", "tensorrt-llm"]
            },
            "frontend": {
              "description": "선택. 요청을 받는 서빙 앞단. engine-server는 엔진 자체 서버(vllm serve·sglang.launch_server·trtllm-serve), triton은 Triton Inference Server 경유다. 모르면 null.",
              "enum": ["engine-server", "triton", null]
            },
            "version": { "type": ["string", "null"] },
            "image_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
            "source_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "inventory_sha256"],
          "properties": {
            "id": { "type": ["string", "null"] },
            "revision": { "type": ["string", "null"] },
            "inventory_sha256": {
              "description": "마운트한 모델 snapshot 전체 파일 목록의 해시(update 비교 조건).",
              "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
            },
            "tokenizer_revision": { "type": ["string", "null"] }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": { "type": "integer", "minimum": 1 },
            "tp_groups": { "description": "TP 그룹 수(기존 필드). 병렬 크기는 tp_size·pp_size·dp_size에 적는다.", "type": "integer", "minimum": 1 },
            "tp_size": { "description": "선택. tensor parallel 크기. 모르면 null.", "type": ["integer", "null"], "minimum": 1 },
            "pp_size": { "description": "선택. pipeline parallel 크기. 모르면 null.", "type": ["integer", "null"], "minimum": 1 },
            "dp_size": { "description": "선택. data parallel 크기(엔진 안 복제 수). 모르면 null.", "type": ["integer", "null"], "minimum": 1 },
            "gpu_count": { "type": ["integer", "null"], "minimum": 0 },
            "gpu_model": { "type": ["string", "null"] },
            "driver": { "type": ["string", "null"] }
          }
        }
      }
    },
    "deployment": {
      "description": "실제 배치 정보. runtime의 enforcement intent와 target 조회에 쓴다. 모르면 null.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["kubernetes", "docker", "host"] },
            "kubernetes_context": { "type": ["string", "null"] },
            "namespace": { "type": ["string", "null"] },
            "engine_container": { "type": ["string", "null"], "minLength": 1 },
            "gateway_schema_version": { "enum": ["runtime-mvp/1.1", "runtime-mvp/1.2"] },
            "gateway_cache_isolation": { "enum": ["off", "per_principal"] },
            "enforcement_intent": { "description": "정책에 intent가 없을 때 쓰는 runtime-enforcement-intent/1.1 원본. runtime이 내부 필드를 검증한다.", "type": ["object", "null"] },
            "gateway_labels": { "$ref": "#/$defs/labels" },
            "engine_labels": { "$ref": "#/$defs/labels" },
            "engine_port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "management_port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    },
    "facts": {
      "description": "적용 판단에 쓰는 사실. 키는 serving-guard에 등록된 것만 허용한다(REGISTERED_FACTS).",
      "type": "object",
      "propertyNames": {
        "enum": [
          "gateway",
          "prefix_cache",
          "prefix_cache_or_shared_cache",
          "shared_or_remote_weights",
          "dynamic_import",
          "alternate_sources_or_formats_or_derived_cache",
          "remote_acquisition_or_retry",
          "managed_or_external_fallback",
          "r10_features",
          "request_code_revision_selection"
        ]
      },
      "additionalProperties": { "$ref": "#/$defs/fact" }
    },
    "framework_profile": {
      "description": "선택. 프레임워크 12개 환경 조건·환경 역할·확인 상태·구조화된 비사용 근거. 없거나 null이면 기존 소비자 동작과 같다.",
      "$ref": "framework-input.schema.json#/$defs/framework_profile"
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "fact": {
      "description": "false로 신고하려면 absence_evidence가 있어야 인정된다. 출처끼리 충돌하면 value는 null, conflict에 후보를 둔다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "origin", "source"],
      "properties": {
        "value": {},
        "origin": { "oneOf": [{ "$ref": "common.schema.json#/$defs/data_origin" }, { "type": "null" }] },
        "source": { "type": ["string", "null"] },
        "absence_evidence": { "type": ["string", "null"] },
        "conflict": { "type": ["array", "null"] }
      },
      "if": { "required": ["conflict"], "properties": { "conflict": { "type": "array", "minItems": 1 } } },
      "then": { "properties": { "value": { "type": "null" } } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.byul.invalid/0.1/framework-input.schema.json",
  "title": "프레임워크 입력 (environment.framework_profile, policy.framework_values)",
  "description": "서빙엔진 보안 프레임워크(update/reference/framework)의 12개 환경 조건과 36개 보호 요구에 맞춘 입력. 독립 문서가 아니라 environment·policy의 선택 필드가 이 정의를 참조한다. 각 조건·요구 안의 키 이름과 선택지는 platform 입력 카탈로그(platform/web/src/lib/frameworkCatalog.ts)가 정한다. 값을 모르면 null로 둔다.",
  "$defs": {
    "catalog_version": { "const": "byul-framework-input/0.1" },
    "input_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "input_value": {
      "description": "선택지 하나(문자열), 예/아니오(boolean), 숫자, 짧은 서술, 선택지 여러 개(문자열 배열), 이름→값 표(예: 의존성 이름→판본). null은 모름.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 2000 },
        { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        { "type": "object", "maxProperties": 256, "additionalProperties": { "type": ["string", "null"], "maxLength": 256 } }
      ]
    },
    "input_values": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/input_key" },
      "additionalProperties": { "$ref": "#/$defs/input_value" }
    },
    "environment_condition": {
      "description": "12개 환경 조건 하나의 실제 배포값. origin·source는 이 조건 값 전체의 출처다. null이면 문서 전체 data_origin을 따르고 자료 위치는 기록하지 않은 것이다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "origin", "source"],
      "properties": {
        "values": { "$ref": "#/$defs/input_values" },
        "origin": { "oneOf": [{ "$ref": "common.schema.json#/$defs/data_origin" }, { "type": "null" }] },
        "source": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "absence_claim": {
      "description": "기능 비사용 근거(프레임워크 Q 보조기 claim과 같은 항목). status가 reviewed이면 모든 항목이 채워져야 한다. reviewed여도 '비적용 후보'일 뿐이며 담당자가 제외 범위를 확인한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "disabled", "nonexposed", "references", "target"],
      "properties": {
        "status": { "enum": ["draft", "reviewed"] },
        "reviewer": { "type": ["string", "null"], "maxLength": 128 },
        "reviewed_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" },
        "disabled": { "type": ["boolean", "null"] },
        "nonexposed": { "type": ["boolean", "null"] },
        "references": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version", "source_commit", "image_digest", "environment_snapshot_sha256"],
          "properties": {
            "engine": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "source_commit": { "type": ["string", "null"] },
            "image_digest": { "type": ["string", "null"], "pattern": "^(?:[a-z0-9][a-z0-9._:/-]*@)?sha256:[0-9a-f]{64}$" },
            "environment_snapshot_sha256": {
              "description": "이 환경 문서에서 revision, created_at, framework_profile.absence_claims를 뺀 정규 JSON의 SHA-256. 환경 입력이 바뀌면 달라져 이전 근거와 연결이 끊긴다.",
              "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
            }
          }
        }
      },
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": {
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "disabled": { "const": true },
          "nonexposed": { "const": true },
          "references": { "minItems": 1 },
          "target": { "properties": { "environment_snapshot_sha256": { "$ref": "common.schema.json#/$defs/sha256" } } }
        }
      }
    },
    "framework_profile": {
      "description": "환경 역할·확인 상태·12개 환경 조건·비사용 근거. null이면 입력 없음.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["catalog_version", "framework_checklist_sha256", "role", "profile_status", "conditions", "absence_claims"],
      "properties": {
        "catalog_version": { "$ref": "#/$defs/catalog_version" },
        "framework_checklist_sha256": {
          "description": "입력 기준이 된 framework data/checklist.json 파일 bytes의 SHA-256.",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
        },
        "role": { "enum": ["current", "candidate", "test", null] },
        "profile_status": { "description": "observed=실제 설치·설정에서 확인, planned=계획값.", "enum": ["observed", "planned", null] },
        "conditions": {
          "type": "object",
          "propertyNames": {
            "enum": ["engine", "entry", "users", "supply", "features", "placement", "host", "weights", "deploy", "load", "observability", "responsibility"]
          },
          "additionalProperties": { "$ref": "#/$defs/environment_condition" }
        },
        "absence_claims": {
          "description": "키는 environment facts의 등록 키와 같다.",
          "type": "object",
          "propertyNames": {
            "enum": ["gateway", "prefix_cache", "prefix_cache_or_shared_cache", "shared_or_remote_weights", "dynamic_import", "alternate_sources_or_formats_or_derived_cache", "remote_acquisition_or_retry", "managed_or_external_fallback", "r10_features", "request_code_revision_selection"]
          },
          "additionalProperties": { "$ref": "#/$defs/absence_claim" }
        }
      }
    },
    "policy_number": {
      "description": "정책 수치·기한 하나. 값과 함께 단위·적용 범위·측정 조건·상태를 둔다. 측정 후 결정이면 value는 null이다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "scope", "condition", "status"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 32 },
        "scope": { "type": ["string", "null"], "maxLength": 256 },
        "condition": { "type": ["string", "null"], "maxLength": 1000 },
        "status": { "enum": ["confirmed", "after_measurement", "undecided"] }
      }
    },
    "policy_requirement": {
      "description": "보호 요구 하나의 승인 기준. decision은 기존 승인 정책을 유지·변경·확인 요청 중 무엇으로 처리하는지다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "values", "numbers", "basis", "note"],
      "properties": {
        "decision": { "enum": ["keep", "change", "needs_confirmation", null] },
        "values": { "$ref": "#/$defs/input_values" },
        "numbers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/input_key" },
          "additionalProperties": { "$ref": "#/$defs/policy_number" }
        },
        "basis": { "description": "근거 문서·기존 승인 기록 위치.", "type": ["string", "null"], "maxLength": 1000 },
        "note": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "framework_values": {
      "description": "36개 보호 요구별 승인 기준값과 승인 조건. 실제 배포값은 environment에 둔다. null이면 입력 없음.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["catalog_version", "framework_checklist_sha256", "requirements", "approval_terms"],
      "properties": {
        "catalog_version": { "$ref": "#/$defs/catalog_version" },
        "framework_checklist_sha256": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "requirements": {
          "description": "키는 보호 요구 번호(예: 3.1).",
          "type": "object",
          "propertyNames": { "pattern": "^[1-8]\\.[1-7]$" },
          "additionalProperties": { "$ref": "#/$defs/policy_requirement" }
        },
        "approval_terms": {
          "description": "approval(누가·언제)에 더해 무엇을 어떤 조건으로 승인했는지. 서명이 아니다.",
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "scope", "conditions"],
          "properties": {
            "decision": { "enum": ["adopted", "conditional", "rejected", null] },
            "scope": { "type": ["string", "null"], "maxLength": 1000 },
            "conditions": { "type": ["string", "null"], "maxLength": 2000 }
          }
        }
      }
    }
  }
}

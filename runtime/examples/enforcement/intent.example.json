{
  "schema": "runtime-enforcement-intent/1.0",
  "namespace": "serving-lab",
  "gateway": {
    "labels": {
      "app": "serving-gateway"
    }
  },
  "engine": {
    "labels": {
      "app": "serving-engine"
    },
    "port": 8000
  },
  "metrics_collectors": [
    {
      "labels": {
        "app": "serving-observer"
      }
    }
  ],
  "dns": {
    "namespace": "kube-system",
    "labels": {
      "k8s-app": "kube-dns"
    },
    "port": 53
  },
  "engine_egress_allow": [
    {
      "fqdn": "telemetry.example.invalid",
      "port": 443,
      "protocol": "TCP"
    },
    {
      "cidr": "192.0.2.0/24",
      "port": 443,
      "protocol": "TCP"
    }
  ],
  "protected_paths": {
    "model_dir": "/opt/serving/assets/model",
    "cache_dir": "/var/cache/serving/engine/example",
    "secret_paths": [
      "/var/run/secrets/serving/probe-secret"
    ]
  },
  "allowed_engine_binaries": [
    "/usr/local/bin/python3",
    "/usr/local/bin/vllm"
  ],
  "tetragon_mode": "monitor"
}

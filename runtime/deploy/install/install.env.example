# Literal KEY=value only; no quoting, interpolation, export, or inline comments.
# Copy outside the repository and chmod 0600. All input paths must be absolute.
CONTEXT=lab-context
NAMESPACE=serving
SERVER_ID=server-01
PLATFORM_URL=https://platform.example.invalid
PLATFORM_CA_FILE=
AGENT_TOKEN_FILE=/secure/agent.token
VIEWER_ENV_FILE=/secure/viewer.env
KUBECONFIG_FILE=/secure/kubeconfig
GATEWAY_DATA_GID=10000
OBSERVE_GID=10010
# Owner of observation directory / separate user collectors; must already exist.
OBSERVATION_USER=ubuntu

# Optional cache observer: all three fields required together; never auto-enabled otherwise.
# Dedicated kubeconfig: readonly get/list Pods in the approved engine namespace only.
CACHE_SETTINGS_FILE=
CACHE_SETTINGS_SHA256=
CACHE_KUBECONFIG_FILE=
CACHE_KUBECTL=/usr/local/bin/kubectl

{
  "schema_version": "runtime-backend/1.0",
  "kind": "vllm",
  "base_url": "http://127.0.0.1:8000",
  "model_map": {
    "test-model": "qwen2.5-0.5b-instruct"
  },
  "credential": {
    "file": "~/.local/state/serving-runtime/s3b-cpu/vllm-api-key"
  },
  "health_path": "/health",
  "models_path": "/v1/models",
  "version_path": "/version",
  "metrics_url": "http://127.0.0.1:8000/metrics",
  "timeouts": {
    "relay_timeout_s": 300,
    "stream_idle_timeout_s": 120,
    "request_deadline_s": 600
  },
  "metrics_map": {
    "requests.running": {
      "metric": "vllm:num_requests_running",
      "type": "gauge",
      "unit": "requests",
      "source_doc": "https://docs.vllm.ai/en/latest/usage/metrics/",
      "verified": false
    },
    "requests.waiting": {
      "metric": "vllm:num_requests_waiting",
      "type": "gauge",
      "unit": "requests",
      "source_doc": "https://docs.vllm.ai/en/latest/usage/metrics/",
      "verified": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.byul.invalid/0.1/runtime-status.schema.json",
  "title": "런타임 상태 스냅샷 (runtime → platform)",
  "description": "runtime 조회 API(/api/status·/api/policy·/api/collectors·/api/target·/api/summary·/api/revalidation·/api/observations)를 읽은 시점의 합성값. 적용 설정은 동작 성공이 아니고, 미확인을 정상으로 바꾸지 않는다. 0.2부터 runtime 자체 대시보드(2026-10-25 삭제)가 보여주던 항목을 모두 담는다. 비밀값(토큰·자격정보 내용)은 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "observation_session_id",
    "environment",
    "run_id",
    "overall",
    "target",
    "policy",
    "backend",
    "concurrency",
    "connections",
    "auth",
    "collectors",
    "store",
    "revalidation",
    "observations",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "const": "byul-runtime-status/0.2"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "observation_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "description": "Gateway 실행 옵션의 요청 환경. 모르면 null.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "overall": {
      "description": "runtime /api/status.status",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "target_id",
        "registration",
        "error_code",
        "instance_id",
        "instance_state",
        "instance_observed_at",
        "instance_pod",
        "instance_restart_count",
        "gateway_hold",
        "comparison_counts",
        "last_history"
      ],
      "properties": {
        "target_ref": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/local_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "registration": {
          "type": "string"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance_state": {
          "type": "string"
        },
        "instance_observed_at": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "instance_pod": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance_restart_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gateway_hold": {
          "description": "대상 불일치로 신규 추론 요청을 보류(503)하는 중이면 그 사유.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason_code",
                "message"
              ],
              "properties": {
                "reason_code": {
                  "type": "string"
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "comparison_counts": {
          "$ref": "#/$defs/compare_counts"
        },
        "last_history": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "reason",
                "recorded_at"
              ],
              "properties": {
                "event": {
                  "type": "string"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recorded_at": {
                  "$ref": "common.schema.json#/$defs/nullable_timestamp"
                }
              }
            }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "bundle_id",
        "loaded",
        "gateway_active",
        "approval_state",
        "valid_until",
        "schema",
        "profile",
        "test_only",
        "cache_isolation",
        "max_n",
        "passthrough_fields",
        "validate_count",
        "loaded_at",
        "load_valid",
        "error_code",
        "error_message",
        "external_enforcement",
        "approval_checked_at",
        "approval_reason_code",
        "validity_items",
        "history",
        "history_store"
      ],
      "properties": {
        "policy_ref": {
          "$ref": "common.schema.json#/$defs/nullable_policy_ref"
        },
        "bundle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "gateway_active": {
          "type": "boolean"
        },
        "approval_state": {
          "enum": [
            "not_configured",
            "verified",
            "last_verified",
            "unverified",
            "rejected",
            "error"
          ]
        },
        "valid_until": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "schema": {
          "description": "runtime 정책 파일 형식(예: runtime-mvp/1.1).",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_only": {
          "description": "시험 전용 프로필(zeroday-lab). 승인된 운영 정책이 아니다.",
          "type": "boolean"
        },
        "cache_isolation": {
          "description": "사용자별 prefix cache 분리 설정과 현재 준비 상태. mode가 null이면 구형 runtime 또는 확인할 수 없는 형식이다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "ready",
            "unavailable_reason_code"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "per_principal",
                null
              ]
            },
            "ready": {
              "type": "boolean"
            },
            "unavailable_reason_code": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "max_n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "passthrough_fields": {
          "description": "검사하지 않고 엔진에 전달하는 추가 필드 이름(값은 없다).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "loaded_at": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "load_valid": {
          "description": "정책 파일 읽기·검증 성공 여부.",
          "type": "boolean"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_enforcement": {
          "type": "string"
        },
        "approval_checked_at": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "approval_reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "validity_items": {
          "description": "유효성 항목(기간·철회·승인 확인).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "state",
              "result"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "history": {
          "description": "정책 로딩 이력(최근 순, 최대 50).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "event",
              "policy_id",
              "policy_version",
              "sha256",
              "previous_version",
              "same_version_content_changed"
            ],
            "properties": {
              "at": {
                "$ref": "common.schema.json#/$defs/nullable_timestamp"
              },
              "event": {
                "type": "string"
              },
              "policy_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "oneOf": [
                  {
                    "$ref": "common.schema.json#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "previous_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "same_version_content_changed": {
                "type": "boolean"
              }
            }
          }
        },
        "history_store": {
          "$ref": "#/$defs/store_state"
        }
      }
    },
    "backend": {
      "description": "엔진(모의 엔진 또는 외부 backend) 연결 점검. 연결 점검이며 추론·관측 동작 검증이 아니다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "url",
        "healthy",
        "reachable",
        "inference_verified",
        "checked_at",
        "error",
        "credential",
        "metrics_credential",
        "receipts_store"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "healthy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inference_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "checked_at": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential": {
          "description": "자격정보 상태(configured·missing·invalid 등). 값은 없다.",
          "type": [
            "string",
            "null"
          ]
        },
        "metrics_credential": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipts_store": {
          "$ref": "#/$defs/store_state"
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_flight",
        "limit"
      ],
      "properties": {
        "in_flight": {
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "limit",
        "rejected",
        "request_header_timeout_s",
        "request_body_timeout_s"
      ],
      "properties": {
        "active": {
          "type": [
            "integer",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rejected": {
          "type": [
            "integer",
            "null"
          ]
        },
        "request_header_timeout_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "request_body_timeout_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "auth": {
      "description": "Gateway API 인증 상태. 주체 이름·토큰은 없다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "principal_count",
        "protected_routes",
        "error_code"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "protected_routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "state",
          "last_success_at",
          "last_attempt_at",
          "last_error",
          "interval_s",
          "stale_after_s",
          "data_origin",
          "origin_detail",
          "detail"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "state": {
            "enum": [
              "disconnected",
              "never",
              "ok",
              "partial",
              "stale",
              "error"
            ]
          },
          "last_success_at": {
            "$ref": "common.schema.json#/$defs/nullable_timestamp"
          },
          "last_attempt_at": {
            "$ref": "common.schema.json#/$defs/nullable_timestamp"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "interval_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "stale_after_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "data_origin": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/data_origin"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin_detail": {
            "$ref": "common.schema.json#/$defs/origin_detail"
          },
          "detail": {
            "description": "수집원별 요약. 해당 없는 수집원은 null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/feed_detail"
              },
              {
                "$ref": "#/$defs/retention_detail"
              },
              {
                "$ref": "#/$defs/metrics_detail"
              },
              {
                "$ref": "#/$defs/asset_detail"
              },
              {
                "$ref": "#/$defs/cilium_detail"
              }
            ]
          }
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "data_dir",
        "last_error",
        "last_error_at",
        "corrupt_lines",
        "corrupt_details"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "error",
            "unknown"
          ]
        },
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error_at": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp"
        },
        "corrupt_lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gateway",
            "engine"
          ],
          "properties": {
            "gateway": {
              "type": "integer",
              "minimum": 0
            },
            "engine": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "corrupt_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line_issue"
          }
        }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_count",
        "current_condition_count",
        "corrupt_lines",
        "evaluation_errors"
      ],
      "properties": {
        "open_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_condition_count": {
          "type": "integer",
          "minimum": 0
        },
        "corrupt_lines": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observations": {
      "description": "저장된 관측 사건 집계(/api/observations).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_source",
        "corrupt_lines",
        "real_hubble_dropped",
        "origins_by_kind"
      ],
      "properties": {
        "by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "corrupt_lines": {
          "type": "integer",
          "minimum": 0
        },
        "real_hubble_dropped": {
          "description": "실제(real) Hubble DROPPED 건수. 거부 확인이 아니라 관측이다.",
          "type": "integer",
          "minimum": 0
        },
        "origins_by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "comparisons": {
      "description": "구성 비교(/api/baseline)와 대상 비교(/api/target). 관측 불일치는 표시만 하고 요청을 자동 차단하지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "target"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/compare_table"
        },
        "target": {
          "$ref": "#/$defs/compare_table"
        }
      }
    }
  },
  "$defs": {
    "compare_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "mismatch",
        "unknown",
        "not_declared"
      ],
      "properties": {
        "match": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_declared": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "store_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "last_error"
      ],
      "properties": {
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "line_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "line",
        "reason"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "feed_detail": {
      "description": "observation_feed_hubble·observation_feed_tetragon: 실시간 수집기 처리 결과와 writer heartbeat.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "processed",
        "accepted",
        "duplicates",
        "rejected",
        "rejected_details",
        "corrupt_lines_total",
        "out_of_window",
        "out_of_window_total",
        "idle",
        "lost_events_total",
        "lost_events_by_source",
        "last_lost_at",
        "loss_detected",
        "writer"
      ],
      "properties": {
        "kind": {
          "const": "observation_feed"
        },
        "processed": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line_issue"
          }
        },
        "corrupt_lines_total": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_window": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_window_total": {
          "type": "integer",
          "minimum": 0
        },
        "idle": {
          "type": "boolean"
        },
        "lost_events_total": {
          "description": "Hubble lost_events의 누적 손실 수. Hubble 유효 줄을 아직 처리하지 않았거나 해당 없는 수집원은 null. 0은 손실 없음이 아니라 처리한 줄에서 loss 레코드를 보지 못했다는 뜻이다.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "lost_events_by_source": {

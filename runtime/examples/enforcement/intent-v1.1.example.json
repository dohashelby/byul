{
  "schema": "runtime-enforcement-intent/1.1",
  "namespace": "serving-lab",
  "gateway": {"labels": {"app": "serving-gateway"}},
  "engine": {"labels": {"app": "serving-engine"}, "port": 8000, "management_port": 8001},
  "metrics_collectors": [{"labels": {"app": "serving-observer"}}],
  "dns": {"namespace": "kube-system", "labels": {"k8s-app": "kube-dns"}, "port": 53},
  "engine_egress_allow": [],
  "acquire": {
    "labels": {"app": "artifact-acquire"},
    "egress_allow": [
      {"fqdn": "artifacts.example.invalid", "port": 443, "protocol": "TCP"},
      {"endpoint": {"app": "test-receiver"}, "port": 8080, "protocol": "TCP"}
    ]
  },
  "test_receivers": [
    {"name": "fixture", "labels": {"app": "test-receiver"}, "port": 8080, "allowed_from": ["acquire"]}
  ],
  "observer_kube_api": false,
  "protected_paths": {
    "model_dir": "/opt/serving/assets/model",
    "cache_dir": "/var/cache/serving/vllm/image-example/revision-example/default",
    "secret_paths": ["/var/run/secrets/serving/probe-secret"]
  },
  "assets": {
    "tokenizer_dir": "/opt/serving/assets/tokenizer",
    "manifest_path": "/opt/serving/approved/manifest.json",
    "cache_root": "/var/cache/serving",
    "cache_generation": {
      "engine": "vllm",
      "image_id": "image-example",
      "model_revision": "revision-example",
      "compile_profile": "default"
    },
    "engine_uid": 10001,
    "acquire_uid": 10002,
    "probe_uid": 10003
  },
  "allowed_engine_binaries": ["/usr/local/bin/vllm"],
  "phase_binaries": {
    "loading": ["/usr/bin/python3"],
    "compiling": ["/usr/bin/python3", "/usr/bin/gcc", "/usr/bin/ld"],
    "inferring": ["/usr/bin/python3"]
  },
  "suspect_binaries": ["/bin/sh", "/bin/bash", "/usr/bin/curl", "/usr/bin/wget"],
  "tetragon_mode": "monitor"
}
